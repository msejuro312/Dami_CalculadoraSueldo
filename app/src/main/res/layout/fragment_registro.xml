<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_panel"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registro_titulo"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_section"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:text="@string/registro_descripcion"
            android:textColor="@color/gris_texto"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutNombre"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:hint="@string/hint_nombre">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="personName"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutDescripcion"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_medium"
            android:hint="@string/hint_descripcion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDescripcion"
                android:layout_width="match_parent"
                android:layout_height="@dimen/description_height"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutCategoria"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:hint="@string/label_categoria"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/autoCompleteCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/label_prioridad"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupPrioridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioPrioridadBaja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prioridad_baja" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioPrioridadMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prioridad_media" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioPrioridadAlta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prioridad_alta" />
        </RadioGroup>

        <TextView
            android:id="@+id/textViewErrorPrioridad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_prioridad"
            android:textColor="@color/error"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_medium"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewSemaforo"
                android:layout_width="@dimen/semaforo_size"
                android:layout_height="@dimen/semaforo_size"
                android:background="@drawable/bg_semaforo_neutro" />

            <TextView
                android:id="@+id/textViewSemaforoEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_medium"
                android:text="@string/semaforo_estado_inicial"
                android:textColor="@color/azul_oscuro"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAgregar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/boton_agregar"
            android:textAllCaps="false"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
