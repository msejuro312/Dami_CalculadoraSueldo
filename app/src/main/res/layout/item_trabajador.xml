<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_medium"
    app:cardBackgroundColor="@color/blanco"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/gris_borde"
    app:strokeWidth="@dimen/stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/item_padding">

        <TextView
            android:id="@+id/textViewCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/codigo_inicial"
            android:textColor="@color/azul_principal"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:text="@string/nombre_inicial"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_item_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewSueldoTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:text="@string/sueldo_inicial"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_item_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:text="@string/area_inicial"
            android:textColor="@color/gris_texto"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/textViewPension"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_medium"
            android:background="@drawable/bg_estado_chip"
            android:paddingHorizontal="@dimen/chip_padding_horizontal"
            android:paddingVertical="@dimen/chip_padding_vertical"
            android:text="@string/pension_afp"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
